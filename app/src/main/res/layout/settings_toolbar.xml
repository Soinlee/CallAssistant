<?xml version="1.0" encoding="utf-8"?>
<!-- 子页面顶部栏：AppBarLayout 设 fitsSystemWindows 使蓝色背景在
     edge-to-edge 下真正贴顶（覆盖状态栏），Toolbar 内容自动下移避开状态栏。
     标题由宿主 Activity 的 setTitle / setSupportActionBar 控制，故不写死 title。 -->
<com.google.android.material.appbar.AppBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_bar_up_description"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
</com.google.android.material.appbar.AppBarLayout>