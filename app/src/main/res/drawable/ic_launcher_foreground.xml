<?xml version="1.0" encoding="utf-8"?>
<!--
    应用图标前景层：白色超粗体数字「1」（代表有记录的通话）+ 右上角绿色小听筒。
    - 数字用超粗圆帽描边，厚重感强，缩到 24dp 依然一眼可辨。
    - 绿色仅作点缀（听筒），面积偏小，避免像微信/支付软件。
    - 核心数字居中偏左，均落在自适应图标安全裁剪区内，边缘不裁切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 数字 1：斜头 -->
    <path
        android:pathData="M44,29 L58,37"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />

    <!-- 数字 1：主竖线（超粗圆帽） -->
    <path
        android:pathData="M45,36 L45,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="22"
        android:strokeLineCap="round" />

    <!-- 右上角：绿色电话听筒（点缀，面积<20%） -->
    <group
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="62"
        android:translateY="20">
